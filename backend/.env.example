ENVIRONMENT=development
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. Needed for account deletion and contact messages. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Only if your project still signs tokens with the legacy HS256 secret. Leave empty for asymmetric (JWKS) projects.
SUPABASE_JWT_SECRET=
# Optional; defaults to <SUPABASE_URL>/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=
CORS_ORIGINS=http://localhost:5173

# ── AI scanner (optional) ──
# Folder containing model.keras and model_meta.json (see ml_training/README.md). Empty = scanner reports "not configured".
MODEL_PATH=
MIN_CONFIDENCE=0.6
MAX_UPLOAD_SIZE_MB=5
SCANS_PER_MINUTE=10
